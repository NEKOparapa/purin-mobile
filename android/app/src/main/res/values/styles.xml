<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="wintermute_canvas">#FFFFFF</color>
    <color name="wintermute_accent">#4959BD</color>
    <color name="wintermute_on_accent">#FFFFFF</color>
    <!-- Older Android versions always draw light navigation icons. -->
    <color name="wintermute_navigation_bar">@android:color/black</color>
    <style name="WintermutePlatformTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <style name="NormalTheme" parent="WintermutePlatformTheme">
        <item name="android:colorBackground">@color/wintermute_canvas</item>
        <item name="android:windowBackground">@color/wintermute_canvas</item>
        <item name="android:statusBarColor">@color/wintermute_canvas</item>
        <item name="android:navigationBarColor">@color/wintermute_navigation_bar</item>
        <item name="android:colorAccent">@color/wintermute_accent</item>
    </style>
    <style name="LaunchTheme" parent="NormalTheme" />
</resources>
